set -e

#-------------------------#
# VARS
#-------------------------#
export version='1.1'
# For speed, support UNICODE OFF
export LC='C'
export LANG='C'

#-------------------------#
# FUNCTIONS
#-------------------------#
MEMORY() # Get memory total and free
{
  while IFS=: read -r j c; do
    if [ "$j" = 'MemTotal' ]; then
      memtotal=$(echo $c | cut -d ' ' -f 1)
      memtotal="$((memtotal/1024))"
    elif [ "$j" = 'MemFree' ]; then
      memfree=$(echo $c | cut -d' ' -f1)
      memfree="$((memfree/1024))"
    fi
  done < /proc/meminfo
}

CPU() # CPU INFO
{
  while IFS=: read -r a p; do
    case $a in
      "model name"*) modelname=$(echo $p | cut -d ' ' -f 1-) ;; esac
  done < /proc/cpuinfo
}


AMBIENT()
{
  # Xorg or Wayland ?
  if [ $XDG_SESSION_TYPE = 'wayland' ]; then
	ambient="$DESKTOP_SESSION"
  else
	ambient="${XDG_CURRENT_DESKTOP:-$DESKTOP_SESSION}"
  fi
}

INFO() # Print all info
{
	local ram gpu
	
	. /etc/os-release # Load Info
   
	ram=$(free -hm | awk '/^Mem:/ {print $3 "/" $2}')
	gpu=$(lspci | grep -Ei 'vga|3d|display' | grep -o '\[[^]]*\]' | tr '\n' ' ')

	cat <<EOF

    ╭────────────╮      $USER@$(uname -n)
    │  TINYFETCH │      -------------------
    ╰────────────╯      OS       : $PRETTY_NAME
  |\__      |\___       KERNEL   : $(uname -rs)
(:> __)X  (:o ___(      UPTIME   : $(uptime -p | sed 's/up //')
  |/        |/          SHELL    : ${SHELL##*/}
                        AMBIENT  : $ambient
                        CPU      : $modelname
                        GPU      : $gpu
                        MEMORY   : $ram
EOF
}
#========================= Main
MEMORY; CPU; AMBIENT; INFO
